# ==========================================
# PromoPilot - Environment Configuration
# ==========================================

# -----------------
# Backend (Node.js & Express)
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/promopilot?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key_here

# Python ML Microservice URL
ML_SERVICE_URL=http://localhost:8000

# Redis & Background Tasks (Optional for Foundation/Queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------
# Frontend (React & Vite)
# -----------------
VITE_API_BASE_URL=http://localhost:5000/api/v1

# -----------------
# ML Service (FastAPI)
# -----------------
ML_PORT=8000
ML_HOST=0.0.0.0
